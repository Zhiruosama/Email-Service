# Local development only. Production credentials must come from a secret store.
DATABASE_URL=postgres://email_service:email_service_dev@localhost:5432/email_service?sslmode=disable
MAIL_POSTGRES_PORT=5432
POSTGRES_IMAGE=postgres:18.4-alpine
RABBITMQ_URL=amqp://email_service:email_service_dev@localhost:5672/
MAIL_RABBITMQ_PORT=5672
MAIL_RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine
MAIL_INSTANCE_ID=local-1
MAIL_PROVIDER=fake
MAIL_GRPC_LISTEN_ADDRESS=:8080
# Development-only identity boundary. Production will replace this with mTLS.
MAIL_GRPC_ALLOW_INSECURE=true
MAIL_DEV_TENANT_ID=10000000-0000-4000-8000-000000000001
# Development-only 32-byte keys encoded with standard base64. Replace them.
MAIL_PAYLOAD_KEY_ID=local-dev-1
MAIL_PAYLOAD_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MAIL_PAYLOAD_FINGERPRINT_KEY_BASE64=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODk=
